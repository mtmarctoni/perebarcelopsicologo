{
  "name": "perebarcelopsicologo",
  "version": "0.0.0-development",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/check-server-only-imports.mjs",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:seo": "playwright test --config=playwright.seo.config.ts",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "knip": "knip",
    "dep-cruise": "depcruise -c .dependency-cruiser.mjs src",
    "doctor": "npx react-doctor@latest",
    "seo:check": "./scripts/seo-check.sh",
    "lighthouse:check": "./scripts/lighthouse-check.sh",
    "env:pull": "vercel env pull .env.local",
    "env:push": "./scripts/vercel-env-push.sh",
    "check": "pnpm lint:fix && pnpm type-check && pnpm dep-cruise && pnpm knip && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm seo:check && pnpm lighthouse:check"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.1",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.32",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
