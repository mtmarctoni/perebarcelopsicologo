{
  "name": "perebarcelopsicologo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/check-server-only-imports.mjs",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "dep-cruise": "depcruise -c .dependency-cruiser.mjs src",
    "doctor": "npx react-doctor@latest",
    "seo:check": "./scripts/seo-check.sh",
    "lighthouse:check": "./scripts/lighthouse-check.sh",
    "env:pull": "vercel env pull .env.local",
    "env:push": "./scripts/vercel-env-push.sh",
    "check": "pnpm lint:fix && pnpm type-check && pnpm dep-cruise && pnpm knip && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm seo:check && pnpm lighthouse:check"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "framer-motion": "^12.42.2",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.16.0",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
